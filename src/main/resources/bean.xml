<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- Định nghĩa Engine bean -->
    <bean id="engine" class="entity.Engine">
        <constructor-arg value="V8" />
    </bean>

    <!-- Định nghĩa Car bean, inject Engine -->
    <bean id="car" class="entity.Car">
        <constructor-arg ref="engine" />
    </bean>


    <bean id="address1" class="entity.Address">
        <constructor-arg value="HCM"/>
        <constructor-arg value="South"/>
        <constructor-arg value="Vietnam"/>
    </bean>

    <!-- Bean Employee (setter injection) -->
    <bean id="employee1" class="entity.Employee">
        <property name="id" value="101"/>
        <property name="name" value="Nguyen Van A"/>
        <property name="address" ref="address1"/>
    </bean>

    <!-- Bean Employee (constructor injection) -->
    <bean id="employee2" class="entity.Employee">
        <constructor-arg value="102"/>
        <constructor-arg value="Tran Thi B"/>
        <constructor-arg ref="address1"/>
    </bean>

</beans>
